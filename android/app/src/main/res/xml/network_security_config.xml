<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN pairing and WebSocket use local RFC 1918 traffic; optional remote tunnels require WSS/HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
